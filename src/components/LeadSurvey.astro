---
// The lead survey. The embed lives in src/data/lead-form.html and is rendered VERBATIM —
// paste the exact GoHighLevel survey/form embed HTML from the old site there, nothing else to change.
// Attribution.astro decorates the GHL iframe src with UTM/source params automatically.
import embed from '../data/lead-form.html?raw';
import Icon from './Icon.astro';
import { site, telHref, smsHref } from '../data/site';
interface Props { heading?: string; sub?: string; id?: string; compact?: boolean }
const {
  heading = 'Get a free quote',
  sub = "Tell us about your project and we'll call you back to set up a free on-site visit and an honest, no-obligation quote.",
  id = 'quote',
  compact = false,
} = Astro.props;
const hasEmbed = embed.trim().length > 0;
---
<div class:list={['quote-card', { compact }]} id={id}>
  <div class="quote-head">
    <p class="quote-kicker"><Icon name="check-circle" size={18} /> Free · No obligation · No pressure</p>
    <h2 class="quote-title">{heading}</h2>
    <p class="quote-sub">{sub}</p>
  </div>
  {hasEmbed ? (
    <div class="quote-embed" set:html={embed} />
  ) : (
    <div class="quote-fallback">
      {/* Shown only until the GHL survey embed is pasted into src/data/lead-form.html */}
      <a class="btn btn-primary btn-block" href={telHref} data-track="call_click"><Icon name="phone" />Call {site.phone}</a>
      <a class="btn btn-outline btn-block" href={smsHref} data-track="sms_click"><Icon name="sms" />Text a photo of the problem</a>
      <p class="small muted">Mon–Fri 9–6 · Sat 10–6</p>
    </div>
  )}
</div>
