---
import Icon from './Icon.astro';
interface Props { quote: string; author: string; source?: string }
const { quote, author, source } = Astro.props;
---
<figure class="review">
  <div class="stars" aria-label="5 out of 5 stars">{[1, 2, 3, 4, 5].map(() => <Icon name="star" size={18} />)}</div>
  <blockquote><p>“{quote}”</p></blockquote>
  <figcaption>— {author}{source && <span>, {source}</span>}</figcaption>
</figure>
