---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import LeadSurvey from '../components/LeadSurvey.astro';
import TownChips from '../components/TownChips.astro';
import { site, telHref, smsHref } from '../data/site';
import { webPage, breadcrumbs } from '../lib/schema';

const path = '/contact-us';
const title = 'Contact Rowe Services | Free Gutter & Exterior Quote';
const description = 'Request a free, no-pressure quote from Rowe Services for seamless gutters, soffit & fascia, siding or screen enclosures. Call or text (352) 706-8913.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Contact', path }];
const schema = [webPage(path, title, description, 'ContactPage'), breadcrumbs(crumbs)];
---
<Base title={title} description={description} path={path} schema={schema}>
  <section class="page-hero split">
    <div class="wrap">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Get your free quote</h1>
        <p class="lede">Tell us a little about what you need. We'll review it, call you back, and set a time to walk the property and give you a clear, written price.</p>
        <ul class="hero-checks">
          <li><Icon name="phone" /><span>Call or text: <a href={telHref} style="color:#fff;font-weight:800">{site.phone}</a></span></li>
          {site.email && <li><Icon name="mail" /><span>Email: <a href={`mailto:${site.email}`} style="color:#fff">{site.email}</a></span></li>}
          <li><Icon name="pin" /><span>Based in {site.address.locality}, {site.address.region} — serving Lake, Marion, Sumter & Orange County</span></li>
          <li><Icon name="clock" /><span>Mon–Fri 9am–6pm · Sat 10am–6pm</span></li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-ghost-light" href={smsHref}><Icon name="sms" />Text photos of the problem</a>
          <a class="btn btn-ghost-light" href={site.facebook} rel="noopener"><Icon name="facebook" />Message on Facebook</a>
        </div>
      </div>
      <LeadSurvey />
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <h2>What happens next</h2>
        <ol class="steps" style="grid-template-columns:1fr">
          <li><h3>We call you back</h3><p>A real person from our team, not a call center.</p></li>
          <li><h3>We walk the property</h3><p>We listen to what you're trying to solve and measure.</p></li>
          <li><h3>You get a clear plan and price</h3><p>Honest, written, no obligation and no pressure.</p></li>
        </ol>
      </div>
      <div>
        <h2>Towns we serve</h2>
        <TownChips />
      </div>
    </div>
  </section>
</Base>
