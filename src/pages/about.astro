---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ReviewCard from '../components/ReviewCard.astro';
import TownChips from '../components/TownChips.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, telHref, quoteHref, yearsInBusiness } from '../data/site';
import { services } from '../data/services';
import { webPage, breadcrumbs } from '../lib/schema';

const path = '/about';
const title = 'About Justin Rowe | Owner-Operated Since 2013 | Rowe Services';
const description = 'Meet Justin Rowe, owner of Rowe Services & Maintenance in Grand Island, FL. Owner-operated since 2013, every job quoted personally and backed for 15 years.';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'About', path }];
const schema = [webPage(path, title, description, 'AboutPage'), breadcrumbs(crumbs)];
---
<Base title={title} description={description} path={path} schema={schema}>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow" style="color:#f0a868">About Rowe Services</span>
      <h1>Owner-operated since {site.founded}. My name is on every job.</h1>
      <p class="lede">Rowe Services & Maintenance is a locally owned, owner-operated exterior company in {site.address.locality}, Florida. We're not a franchise, we're not a call center, and we don't chase volume.</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap owner" id="justin-rowe">
      <div class="owner-card">
        <div class="initials" aria-hidden="true">JR</div>
        <h3>{site.owner.name}</h3>
        <p class="mb-0">Owner & operator</p>
        <dl>
          <dt>Founded</dt><dd>{site.founded} ({yearsInBusiness}+ years)</dd>
          <dt>Home base</dt><dd>{site.address.locality}, FL</dd>
          <dt>Counties</dt><dd>Lake, Marion, Sumter, Orange</dd>
          <dt>Warranty</dt><dd>15 years on installs</dd>
        </dl>
      </div>
      <div class="prose">
        <h2>Hi, I'm Justin Rowe</h2>
        <p>I've been installing seamless gutters and doing exterior work for homeowners in Lake, Marion, Sumter and Orange County since {site.founded}. My name goes on the truck, on the quote and on a 15-year warranty — because I know my crew's sealant process holds up in Florida rain.</p>
        <p>We install 6" aluminum seamless K-style gutters: one continuous piece, no sectional joints, far fewer places a leak can start. Alongside gutters, we install soffit and fascia, handle vinyl siding start to finish, and build and repair screen enclosures.</p>
        <p>We deliberately limit the jobs we take so every homeowner gets the owner — and the quality that comes with that. I quote it, I manage it, and I follow up. You'll know my name, my number, my face and my word from the first call to the final walkthrough.</p>
        <!-- TODO: add a real photo of Justin + crew/truck (public/justin-rowe.jpg) and a short personal story (family, why he started in 2013). -->
      </div>
    </div>
  </section>
  <section class="section band">
    <div class="wrap">
      <div class="section-head"><span class="eyebrow">How we work</span><h2>Four promises on every job</h2></div>
      <div class="usp-grid">{site.usps.map((u) => <div class="usp"><Icon name={u.icon} /><h3>{u.title}</h3><p>{u.text}</p></div>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="wrap split">
      <div>
        <h2>What we do</h2>
        <ul class="checklist">{services.map((s) => <li><Icon name="check-circle" /><span><a href={`/services/${s.slug}`}><strong>{s.name}</strong></a> — {s.card}</span></li>)}</ul>
        <h2 class="mt-2">Where we work</h2>
        <TownChips />
      </div>
      <div>
        <ReviewCard {...site.reviews[0]} />
        <div class="card mt-2">
          <h3>Talk to the owner directly</h3>
          <p>Call or text {site.phone}. Mon–Fri 9–6, Sat 10–6.</p>
          <div class="btn-row"><a class="btn btn-primary" href={quoteHref}>Get my free quote</a><a class="btn btn-outline" href={telHref}><Icon name="phone" />Call Justin</a></div>
        </div>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
