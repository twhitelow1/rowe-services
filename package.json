{
  "name": "rowe-services",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:prod": "PUBLIC_SITE_INDEXABLE=true astro build --outDir dist-prod",
    "preview": "astro preview",
    "check": "astro check",
    "test": "npm run test:unit && npm run test:build",
    "test:unit": "node --test tests/data.test.ts",
    "test:build": "node --test tests/build.test.mjs tests/ai-visibility.test.mjs",
    "test:prod": "npm run build:prod && node --test tests/prod.test.mjs",
    "test:seo": "python3 tools/seo_audit.py dist --site https://rowe-services.com",
    "test:e2e": "playwright test",
    "ci": "npm run check && npm run build && npm test && npm run test:seo && npm run test:prod && npm run test:e2e",
    "icons": "node tools/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "astro": "^7.3.6"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  }
}
